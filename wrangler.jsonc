{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatandcode",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "app.chatcode.ca",
      "custom_domain": true,
    },
  ],
}
