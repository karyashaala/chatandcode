# Optional: ChatAndCode Connect source builds
# `cp .env.example .env` enables ChatAndCode Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Clerk instance used in official builds. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
CHATANDCODE_CLERK_PUBLISHABLE_KEY=pk_test_c2FjcmVkLWZseS04MTQ5LmNsZXJrLmFjY291bnRzLmRldiQ
CHATANDCODE_CLERK_JWT_TEMPLATE=t3-relay
CHATANDCODE_CLERK_CLI_OAUTH_CLIENT_ID=cSNWQZF30uV4Jw7N

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in CHATANDCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# CHATANDCODE_APPLE_TEAM_ID=ABC1234567
# CHATANDCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/chatandcode.provisionprofile
# CHATANDCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
CHATANDCODE_RELAY_URL=https://relay.chatcode.ca

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.chatcode.ca; override to test against a staging deployment.
# CHATANDCODE_HOSTED_APP_URL=https://nightly.app.chatcode.ca

# Public, ingest-only mobile OpenTelemetry configuration.
# CHATANDCODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# CHATANDCODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# CHATANDCODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
